{
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @ai-readiness/web",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-readiness-diagnosis.onrender.com/api/:path*"
    },
    {
      "source": "/public/:path*",
      "destination": "https://ai-readiness-diagnosis.onrender.com/public/:path*"
    },
    {
      "source": "/health",
      "destination": "https://ai-readiness-diagnosis.onrender.com/health"
    },
    {
      "source": "/ready",
      "destination": "https://ai-readiness-diagnosis.onrender.com/ready"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
